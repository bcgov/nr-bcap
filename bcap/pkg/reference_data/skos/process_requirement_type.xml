<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:arches="http://localhost:82/"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <skos:Concept rdf:about="http://localhost:82/00388d7e-faeb-43fb-ba17-ce8de2876e08">
    <skos:inScheme>
      <skos:ConceptScheme rdf:about="http://localhost:82/b35aa446-66a0-4ab0-95cf-c51bf1d043d4">
        <dcterms:title>Process Requirement Type</dcterms:title>
      </skos:ConceptScheme>
    </skos:inScheme>
    <skos:definition xml:lang="en">This is a Process Requirement that is a simple checklist. Typically this is used to document a set of internal steps used to review submissions.</skos:definition>
    <skos:prefLabel xml:lang="en">Checklist</skos:prefLabel>
    <dcterms:identifier>http://localhost:82/plugins/controlled-list-manager/item/00388d7e-faeb-43fb-ba17-ce8de2876e08</dcterms:identifier>
    <arches:sortorder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</arches:sortorder>
  </skos:Concept>
  <skos:Concept rdf:about="http://localhost:82/44ecc87d-9d39-465b-bdf0-00ee31b35dc3">
    <arches:sortorder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</arches:sortorder>
    <skos:definition xml:lang="en">This is a Requirement that is a simple document submission. (eg Final Report, Preliminary Field Report, etc). It is backed by the Requirement Submission resource model, which is qualified by different document types.</skos:definition>
    <skos:inScheme rdf:resource="http://localhost:82/b35aa446-66a0-4ab0-95cf-c51bf1d043d4"/>
    <dcterms:identifier>http://localhost:82/plugins/controlled-list-manager/item/44ecc87d-9d39-465b-bdf0-00ee31b35dc3</dcterms:identifier>
    <skos:prefLabel xml:lang="en">Document Submission</skos:prefLabel>
  </skos:Concept>
  <skos:Concept rdf:about="http://localhost:82/923ffd23-a15d-44f9-a664-7a8a9359d649">
    <arches:sortorder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</arches:sortorder>
    <skos:definition xml:lang="en">This is a requirement that is backed by a business-specific resource model (eg Alteration Intention, Site Visit Submission).</skos:definition>
    <skos:inScheme rdf:resource="http://localhost:82/b35aa446-66a0-4ab0-95cf-c51bf1d043d4"/>
    <skos:prefLabel xml:lang="en">Workflow</skos:prefLabel>
    <dcterms:identifier>http://localhost:82/plugins/controlled-list-manager/item/923ffd23-a15d-44f9-a664-7a8a9359d649</dcterms:identifier>
  </skos:Concept>
  <skos:Concept rdf:about="http://localhost:82/5cbc8c6c-5be4-476b-bb55-cb6125b5268c">
    <skos:prefLabel xml:lang="en">Grouping</skos:prefLabel>
    <skos:inScheme rdf:resource="http://localhost:82/b35aa446-66a0-4ab0-95cf-c51bf1d043d4"/>
    <arches:sortorder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</arches:sortorder>
    <skos:definition xml:lang="en">This is a requirement that is only used to group a set of requirements together. It does not have any requirements/data of its own.</skos:definition>
    <dcterms:identifier>http://localhost:82/plugins/controlled-list-manager/item/5cbc8c6c-5be4-476b-bb55-cb6125b5268c</dcterms:identifier>
  </skos:Concept>
</rdf:RDF>
