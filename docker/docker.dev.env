# Uncomment this to enable debugging in the container
#PYCHARM_DEBUG=true
#PYCHARM_DEBUG_PORT=5680

# Uncomment to run Django under debugpy for VSCode "Python: Remote Attach" (host port 5690)
#VSCODE_DEBUG=true
#VSCODE_DEBUG_PORT=5678

# Set this to a long hex value to make the Jupyter server token stable
#JUPYTER_TOKEN=