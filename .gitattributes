# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto
# Jupyter notebooks - strip outputs/execution counts before committing.
# Requires nbstripout: run `nbstripout --install` after cloning (jupyter deps group).
*.ipynb filter=nbstripout diff=ipynb
*.zpln filter=nbstripout
# Known binary formats
*.png binary
*.jpg binary
*.ico binary
*.gif binary
*.ttf binary
*.woff binary
*.woff2 binary